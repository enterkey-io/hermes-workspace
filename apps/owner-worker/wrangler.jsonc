{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hermes-workspace-owner",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/.well-known/hermes-workspace.json"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hermes-workspace-owner",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": false },
  "send_metrics": false,
}
